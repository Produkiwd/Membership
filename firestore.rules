rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'stephen.tssgroup@gmail.com') ||
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMember(data) {
      return data.keys().hasAll(['userId', 'email', 'name', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 7 && data.keys().size() <= 13 &&
             data.userId is string && data.userId.size() <= 128 && (data.userId == request.auth.uid || isAdmin()) &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['admin', 'member'] &&
             data.status in ['active', 'suspended'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time &&
             (!('tier' in data) || data.tier is string) &&
             (!('group' in data) || data.group is string) &&
             (!('allowedPortals' in data) || data.allowedPortals is list) &&
             (!('sinadMateri' in data) || data.sinadMateri is bool) &&
             (!('sinadExercise' in data) || data.sinadExercise is bool) &&
             (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp);
    }

    function isValidMemberUpdate(data) {
       return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['admin', 'member'] &&
             data.status in ['active', 'suspended'] &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time &&
             (!('tier' in data) || data.tier is string) &&
             (!('group' in data) || data.group is string) &&
             (!('allowedPortals' in data) || data.allowedPortals is list) &&
             (!('sinadMateri' in data) || data.sinadMateri is bool) &&
             (!('sinadExercise' in data) || data.sinadExercise is bool) &&
             (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp);
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().size() == 2 &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt == request.time;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /members/{memberId} {
      allow get: if isSignedIn() && (request.auth.uid == memberId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isValidId(memberId) && isValidMember(incoming()) && (
        (memberId == request.auth.uid && incoming().role == 'member') || 
        isAdmin() ||
        (memberId == request.auth.uid && request.auth.token.email == 'stephen.tssgroup@gmail.com' && incoming().role == 'admin')
      );
      
      allow update: if isSignedIn() && isValidId(memberId) && isValidMemberUpdate(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == memberId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) &&
          incoming().userId == existing().userId &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().createdAt == existing().createdAt
        )
      );

      allow delete: if isAdmin();
    }

    match /invitations/{email} {
      allow get: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidInvitation(incoming()) && incoming().email == email;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
